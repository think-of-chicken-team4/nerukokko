# Webアプリの環境変数のひな形。コピーして .env.local を作り、値を入れる（.env.local はコミットしない）。
#   cp .env.example .env.local
# ローカル開発では、server/ で `npx supabase status` を実行すると値が表示される。

# Supabase の URL（ローカル：http://127.0.0.1:54321）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の publishable キー（sb_publishable_ で始まる。ブラウザに出てよい値）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
