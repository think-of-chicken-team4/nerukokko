# 鶏（Raspberry Pi）の設定の見本。ラズパイでは /etc/nerukokko/chicken.env にコピーして値を入れる（deploy/install.sh が作る）。
# このファイル（.env.example）には秘密の値を書かない。chicken.env は Git に入れない。
# 「実機で調整」の値は docs/hw-verification.md の検証の結果で決める。空のままなら、かっこ内の既定値を使う。

# ===== サーバー（必須）=====
# 例：https://xxxx.supabase.co（ローカルの試験なら http://<PC の IP>:54321）
SUPABASE_URL=
# sb_publishable_…（公開してよい値）
SUPABASE_PUBLISHABLE_KEY=
# Webアプリの「デバイス」で鶏を登録したときに一度だけ出た値（秘密）
DEVICE_TOKEN=

# ===== 保存先・間隔 =====
# 送信待ちのデータ・アラーム・声の保存先
DATA_DIR=/var/lib/nerukokko
# device-sync の間隔（30）
SYNC_INTERVAL_SEC=
# 計測データを送る間隔（60）
SEND_INTERVAL_SEC=
# 温湿度・照度を測る間隔（60）
ENVIRONMENT_INTERVAL_SEC=

# ===== アラーム =====
# 巣に戻らなくても、この秒数で止める（1800）
ALARM_MAX_RING_SEC=
# LED をだんだん明るくする秒数（60）
ALARM_SUNRISE_SEC=
# アラームのセリフ（空なら「コケコッコー！おはようコケ！…」）
ALARM_PHRASE=

# ===== 寝返り（実機で調整：E1・Issue #33）=====
# たまごの加速度がこれ（g）以上変わったら「動きあり」（0.05）
TURN_MIN_CHANGE_G=
# この秒数以内の動きは寝返り1回（10）
TURN_MERGE_SEC=

# ===== いびき・寝言（たまごのマイク。実機で調整：E2）=====
# 背景の音量のこの倍を超えたら「大きな音」（3.0）
SOUND_LOUD_RATIO=
# 静かな部屋で小さな音を拾わないための下限（300）
SOUND_MIN_LOUD_LEVEL=

# ===== ミリ波レーダー A111（実機で調整：C2・Issue #16）=====
# レーダーを使う（true）
RADAR_ENABLED=
# レーダーなしで試すとき true（false）
RADAR_USE_MOCK=
# socket / spi / uart（socket。exploration server につなぐ）
RADAR_LINK=
# exploration server の場所（127.0.0.1）
RADAR_HOST=
# これ以上の反射で「人がいる」（100）
RADAR_PRESENCE_ENV_MAX=
# ばらつきがこれ以上で「呼吸している」（0.5）
RADAR_BREATHING_STD_MM=
# いる／いないが変わったと判断するまでの秒数（60）
RADAR_PRESENCE_HOLD_SEC=

# ===== 温湿度・照度（実機で調整：C3）=====
# 市販の温湿度計との差。ラズパイの熱で高めに出る分を引く（0。例：-1.5）
ENV_TEMP_OFFSET_C=
# 湿度の差（0）
ENV_HUMIDITY_OFFSET_PCT=

# ===== マイク（ボタンで話すときの録音。実機で調整：C4）=====
# 録音デバイスの名前か番号（空なら既定。hwtest/audio_test.py devices で確認）
MIC_DEVICE=
# 声が小さいときに上げる（1.0）
MIC_GAIN=
# これより大きい音を「話している」とみなす（500）
MIC_VOICE_LEVEL=
# 話し終わってこの秒数静かなら録音を止める（1.5）
MIC_SILENCE_SEC=
# 録音の最長（12）
MIC_MAX_SEC=

# ===== スピーカー（実機で調整：C5）=====
# aplay -D に渡す名前（空なら既定。aplay -L で確認）
AUDIO_OUTPUT_DEVICE=
# 0〜1（0.8）
SPEAKER_VOLUME=

# ===== LED WS2812B（実機で調整：C6）=====
# GPIO 番号（12。GPIO18 は I2S と重なるので使わない）
LED_PIN=
# LED の数（2）
LED_COUNT=
# 0〜255（180）
LED_BRIGHTNESS=

# ===== 画面（DSI。D1〜D3）=====
# 状態を書く・操作を読む間隔、秒（0.3）
DISPLAY_POLL_SEC=
# 状態がこれより古いと本体が止まったとみなす、秒（5）
DISPLAY_STALE_SEC=
# 何も触らないとメニューから目の画面へ戻る、秒（20）
MENU_TIMEOUT_SEC=
