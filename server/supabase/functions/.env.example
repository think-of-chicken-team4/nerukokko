# Edge Functions の環境変数の見本。コピーして .env を作り、値を入れる（.env は Git に入らない）。
#   cp supabase/functions/.env.example supabase/functions/.env
# 本番は `npx supabase secrets set GEMINI_API_KEY=...` で入れる。

# Gemini の API キー（Google AI Studio →「Get API key」。2026-05-28 以降は「AQ.」で始まる）
GEMINI_API_KEY=

# 使うモデル（カンマ区切り、上から順に試す）。空なら gemini-3.6-flash,gemini-3.8-flash
GEMINI_MODELS=

# 声（TTS）に使うモデル（カンマ区切り）。空なら gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
GEMINI_TTS_MODELS=
